/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
 {
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dreamforge-cf",
	"main": "worker/index.ts",
	"compatibility_date": "2025-08-10",
	"compatibility_flags": ["nodejs_compat"],
    "version_metadata": {
        "binding": "CF_VERSION_METADATA"
    },
	"assets": {
		"directory": "dist",
		"not_found_handling": "single-page-application",
		// "run_worker_first": ["!/src/*", "!/api/docs/*"],
        "run_worker_first": true,
        "binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
        "head_sampling_rate": 1,
	},
    "unsafe": {
        "bindings": [
            {
                "name": "API_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2101",
                "simple": { "limit": 10000, "period": 60 }
            },
            {
                "name": "AUTH_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2102",
                "simple": { "limit": 1000, "period": 60 }
            }
        ]
    },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	"ai": {
		"binding": "AI",
        "remote": true
	},
    "dispatch_namespaces": [
        {
            "binding": "DISPATCHER",
            "namespace": "vibesdk-default-namespace",
            "remote": true
        }
    ],
	"containers": [
		{
			"class_name": "UserAppSandboxService",
			"image": "./SandboxDockerfile",
            // "image": "registry.cloudflare.com/vibesdk-production-userappsandboxservice:cfe197fc",
            // Altering max_instances value will have no effect. Please use the MAX_SANDBOX_INSTANCES var instead.
			"max_instances": 10,
            // ATTENTION: Altering instance_type value will have no effect. Please use the SANDBOX_INSTANCE_TYPE var instead.
            "instance_type": "standard-3",
            "rollout_step_percentage": 100
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibesdk-db",
			"database_id": "0d8d35e2-91e1-4231-90b1-f49cc313876c",
			"migrations_dir": "migrations",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "CodeGeneratorAgent",
				"name": "CodeGenObject"
			},
            {
                "class_name": "UserAppSandboxService",
                "name": "Sandbox"
            },
            {
                "class_name": "DORateLimitStore",
                "name": "DORateLimitStore"
            },
            {
                "class_name": "CodebaseAnalyzer",
                "name": "CodebaseAnalyzerObject",
                "limits": {
                    "cpu_ms": 300000
                }
            }
		]
	},
    "r2_buckets": [
      {
        "binding": "TEMPLATES_BUCKET",
        "bucket_name": "vibesdk-templates",
        "remote": true
      }
    ],
    "kv_namespaces": [
        {
            "binding": "VibecoderStore",
            "id": "7fc3452e180a4a8997c52346f41685d1",
            "remote": true
        }
    ],
    // "placement": {
    //   "mode": "smart"
    // },
	"migrations": [
		{
			"new_sqlite_classes": [
				"CodeGeneratorAgent",
				"UserAppSandboxService"
			],
			"tag": "v1"
		},
        {
            "new_sqlite_classes": [
                "DORateLimitStore"
            ],
            "tag": "v2"
        },
        // v3 retroactively declares both UserSecretsStore AND CodebaseAnalyzer
        // as SQLite Durable Object classes. The server has migration_tag "v3"
        // already applied, so CF won't reapply this — migrations are tracked
        // by tag only, not by contents. The declarations here exist solely to
        // satisfy wrangler's local static validation, which requires any
        // subsequent `deleted_classes` to reference a class that appears
        // earlier in the migration list.
        //
        // Both classes are dead and resolved in later tags:
        // - CodebaseAnalyzer: bound on the live worker by a prior iteration
        //   that's been absent from source for 5+ months. Deleted in v4.
        // - UserSecretsStore: phantom from an interim upstream sync; never
        //   had a runtime binding or any live DO instances. The user-secrets
        //   feature is implemented in D1 via
        //   `worker/database/services/SecretsService.ts`, not as a DO.
        //   Deleted in v5 (after a one-deploy tombstone export to satisfy
        //   CF's invariant that `deleted_classes` requires the class to have
        //   been exported by the previous deploy — error 10074).
        {
            "new_sqlite_classes": [
                "UserSecretsStore",
                "CodebaseAnalyzer"
            ],
            "tag": "v3"
        },
        // v4 deletes CodebaseAnalyzer permanently. Asynchronous, irreversible
        // (CF docs). Confirmed safe: zero references to CodebaseAnalyzer
        // anywhere in worker/* or shared/* (grep verified). This was the
        // class blocking the first successful production deploy since
        // 2025-12-15.
        {
            "deleted_classes": [
                "CodebaseAnalyzer"
            ],
            "tag": "v4"
        },
        // v5 deletes UserSecretsStore permanently. Asynchronous, irreversible
        // (CF docs). Confirmed safe: no instances on the production worker
        // (the class never had a binding) and no callers in worker/* or
        // shared/*. The previous deploy (PR #18) exported a tombstone
        // `UserSecretsStore` class from worker/index.ts solely so CF would
        // accept this `deleted_classes` migration; that tombstone export is
        // removed in the same commit as this migration.
        {
            "deleted_classes": [
                "UserSecretsStore"
            ],
            "tag": "v5"
        },
        // v6 resurrects CodebaseAnalyzer. The class was deleted in v4 because
        // the BYOP (Bring Your Own Project) feature it backed had been lost
        // during a prior refactor and no source code referenced it. The
        // feature has now been fully recovered (PRs 20a–20d), so the Durable
        // Object class is needed again.
        //
        // Note: pre-v4 CodebaseAnalyzer instances were permanently destroyed
        // by the v4 `deleted_classes` migration (CF docs: asynchronous and
        // irreversible). This v6 migration creates a fresh class with no
        // historical state — any in-flight analyses from before v4 are
        // unrecoverable. New BYOP imports will create new instances cleanly.
        {
            "new_sqlite_classes": [
                "CodebaseAnalyzer"
            ],
            "tag": "v6"
        }
    ],
	"vars": {
        "TEMPLATES_REPOSITORY": "https://github.com/cloudflare/vibesdk-templates",
        "ALLOWED_EMAIL": "",
        "DISPATCH_NAMESPACE": "vibesdk-default-namespace",
        "ENABLE_READ_REPLICAS": "true",
        "CLOUDFLARE_AI_GATEWAY": "vibesdk-gateway",
        "CUSTOM_DOMAIN": "app.getdreamforge.com",
        "CUSTOM_PREVIEW_DOMAIN": "app.getdreamforge.com",
        "MAX_SANDBOX_INSTANCES": "10",
        "SANDBOX_INSTANCE_TYPE": "standard-3",
        "USE_CLOUDFLARE_IMAGES": false,
    },
	"workers_dev": false,
    "preview_urls": false,
    "routes": [
        // Marketing-facing apex + www. Bare custom domains — these capture all
        // paths on their hostname. Declared here so wrangler keeps them
        // attached across deploys (wrangler reconciles custom domains against
        // this list and removes any not declared).
        {
            "pattern": "getdreamforge.com",
            "custom_domain": true
        },
        {
            "pattern": "www.getdreamforge.com",
            "custom_domain": true
        },
        // App domain — custom domain for the bare hostname plus a wildcard
        // route to handle preview-app subdomains (e.g. customer-1.app.getdreamforge.com).
        {
            "pattern": "app.getdreamforge.com",
            "custom_domain": true
        },
        {
            "pattern": "*app.getdreamforge.com/*",
            "custom_domain": false,
            "zone_id": "157d05cb90f7190794c33e37bef447db"
        }
    ]
}